---
import { withBase } from "../utils/paths";

interface Props {
  brand?: string;
  title: string;
  lede: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  brand = "FISCONT",
  title,
  lede,
  primaryHref = "/contact",
  primaryLabel = "Discută un proiect",
  secondaryHref = "/servicii",
  secondaryLabel = "Vezi serviciile",
} = Astro.props;

const heroImage = `url('${withBase("/hero.jpg")}')`;
---

<section class="hero" aria-label="Prezentare" style={`--hero-image: ${heroImage}`}>
  <div class="hero-media" aria-hidden="true"></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="hero-brand">{brand}</p>
    <h1>{title}</h1>
    <p class="hero-lede">{lede}</p>
    <div class="cta-group">
      <a class="btn btn-primary" href={withBase(primaryHref)}>{primaryLabel}</a>
      <a class="btn btn-ghost" href={withBase(secondaryHref)}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(11, 31, 58, 0.15), transparent 45%),
      var(--hero-image) center / cover no-repeat;
    transform: scale(1.04);
    animation: hero-drift 18s var(--ease) infinite alternate;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 31, 58, 0.35) 0%, rgba(11, 31, 58, 0.72) 48%, rgba(11, 31, 58, 0.92) 100%),
      radial-gradient(800px 400px at 20% 80%, rgba(154, 123, 60, 0.22), transparent 60%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: calc(var(--header-h) + 4rem) 0 4.5rem;
    max-width: 46rem;
    margin-left: max(var(--space), calc((100% - var(--max)) / 2));
    margin-right: auto;
    animation: hero-in 1s var(--ease) both;
  }

  .hero-brand {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 0.95;
    margin: 0 0 1.25rem;
    color: var(--white);
  }

  .hero h1 {
    color: var(--white);
    font-size: clamp(1.55rem, 3.2vw, 2.35rem);
    font-weight: 500;
    max-width: 20ch;
    margin-bottom: 1rem;
  }

  .hero-lede {
    max-width: 34rem;
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.86);
    margin: 0;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.08) translate3d(-1.5%, -1%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media,
    .hero-content {
      animation: none;
    }
  }
</style>
