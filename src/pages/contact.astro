---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Contact Fiscont Proiecte"
  description="Contactează Fiscont Proiecte pentru audit intern, reorganizare financiară sau setarea unui departament financiar. București — +40 759 011 054."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact Fiscont Proiecte",
    description:
      "Contact pentru audit intern, reorganizare financiară sau setarea unui departament financiar.",
    inLanguage: "ro-RO",
  }}
>
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1>Contact</h1>
      <p class="lede">
        Spune-ne pe scurt ce proiect ai în vedere. Răspundem în zilele lucrătoare.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel reveal">
      <h2>Date de contact</h2>
      <ul class="contact-list">
        <li>
          <span>Telefon</span>
          <a href="tel:+40759011054">+40 759 011 054</a>
        </li>
        <li>
          <span>Email</span>
          <a href="mailto:office@fiscontprint.ro">office@fiscontprint.ro</a>
        </li>
        <li>
          <span>Sediu Fiscont</span>
          <address>
            Bd. Unirii nr. 64, Bloc K4, scara 4, et. 3<br />
            București, România
          </address>
        </li>
        <li>
          <span>Program</span>
          <p>Luni–Vineri, 09:00–18:00</p>
        </li>
      </ul>

      <div class="cta-group">
        <a class="btn btn-primary" href="tel:+40759011054">Sună acum</a>
        <a class="btn btn-outline" href="mailto:office@fiscontprint.ro">Trimite email</a>
      </div>

      <p class="muted note">
        Pentru contabilitate, HR și consultanță juridică:
        <a href="https://fiscontsrl.ro/" target="_blank" rel="noopener noreferrer">fiscontsrl.ro</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-panel {
    max-width: 36rem;
  }

  .contact-panel h2 {
    margin-bottom: 0.25rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .contact-list li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .contact-list span {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
    font-weight: 500;
  }

  .contact-list a,
  .contact-list address,
  .contact-list p {
    font-style: normal;
    margin: 0;
    color: var(--navy);
    text-decoration: none;
    font-size: 1.05rem;
  }

  .contact-list a:hover {
    color: var(--blue);
  }

  .note {
    margin-top: 1.75rem;
    font-size: 0.95rem;
  }
</style>
