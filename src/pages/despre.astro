---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../utils/paths";
import "../styles/global.css";
---

<BaseLayout
  title="Despre"
  description="Fiscont Proiecte — linia de servicii conexe a Fiscont: audit, reorganizare și departamente financiare pe proiect."
>
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1>Despre Fiscont Proiecte</h1>
      <p class="lede">
        Parte din ecosistemul Fiscont. Focus pe proiecte, nu pe volum de
        clienți recurenti.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <h2>Legătura cu Fiscont</h2>
        <p class="muted">
          <a href="https://fiscontsrl.ro/" target="_blank" rel="noopener noreferrer">Fiscont</a>
          (fiscontsrl.ro) rămâne partenerul de contabilitate, resurse umane și
          consultanță juridică. Pe fiscontprint.ro prezentăm serviciile conexe
          pe proiect: audit intern, reorganizare financiară și crearea
          departamentului financiar.
        </p>
        <p class="muted">
          Fondată pe experiența din 2012 încoace și pe apartenența la C.E.C.C.A.R.,
          echipa Fiscont aduce în aceste proiecte aceeași exigență de
          conformitate și claritate pe care o cunoști din serviciile continue.
        </p>
      </div>
      <div class="panel reveal">
        <h3>Ce nu suntem</h3>
        <ul class="prose-list">
          <li>Nu suntem tipografie sau serviciu de print/scan</li>
          <li>Nu înlocuim site-ul oficial de contabilitate</li>
          <li>Nu vindem „pachete infinite” — lucrăm pe proiecte selectate</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container reveal">
      <h2>De ce proiecte limitate</h2>
      <p class="wide muted">
        Setarea unui departament financiar și reorganizările serioase cer
        atenție. Limităm numărul de proiecte active ca să putem livra cu echipe
        complementare și cu predare reală — inclusiv pe zona de digitalizare
        (contacte, avize, supervizări), pe care o integrăm acum în metodă.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <h2>Următorul pas</h2>
      <p class="muted" style="max-width: 36rem">
        Dacă ai un proiect pe masă sau vrei să înțelegi dacă ți se potrivește
        această linie de servicii, scrie-ne.
      </p>
      <div class="cta-group">
        <a class="btn btn-primary" href={withBase("/contact")}>Contact</a>
        <a class="btn btn-outline" href={withBase("/servicii")}>Servicii</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .panel {
    padding: 1.75rem;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--line);
  }

  .panel h3 {
    margin-bottom: 0.5rem;
  }

  .band {
    background: rgba(255, 255, 255, 0.45);
    border-block: 1px solid var(--line);
  }

  .wide {
    max-width: 42rem;
    font-size: 1.1rem;
  }
</style>
